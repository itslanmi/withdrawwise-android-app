<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddWithdrawalActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.15" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.85" />

    <TextView
        android:id="@+id/textAtmName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ATM Name"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/textAtmBank"
        app:layout_constraintStart_toStartOf="@+id/textAtmBank"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/textAtmBank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="ATM Bank"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/textAtmFee"
        app:layout_constraintStart_toStartOf="@+id/textAtmFee"
        app:layout_constraintTop_toBottomOf="@+id/textAtmName" />

    <TextView
        android:id="@+id/textAtmFee"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ATM Fee"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/textLabelAmount"
        app:layout_constraintStart_toStartOf="@+id/textLabelAmount"
        app:layout_constraintTop_toBottomOf="@+id/textAtmBank" />

    <EditText
        android:id="@+id/editAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="150dp"
        android:ems="10"
        android:inputType="number"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline4"
        app:layout_constraintStart_toStartOf="@+id/guideline3" />

    <Button
        android:id="@+id/btnLog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Log Withdrawal"
        app:layout_constraintEnd_toStartOf="@+id/guideline4"
        app:layout_constraintStart_toStartOf="@+id/guideline3"
        app:layout_constraintTop_toBottomOf="@+id/editAmount" />

    <TextView
        android:id="@+id/textLabelAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Enter amount below"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/editAmount"
        app:layout_constraintStart_toStartOf="@+id/editAmount" />
</androidx.constraintlayout.widget.ConstraintLayout>